# ================================
# Configuración de Base de Datos
# ================================
DB_HOST=db
DB_PORT=1433
DB_NAME=prueba
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ================================
# URLs de Microservicios
# ================================
ACCOUNT_SERVICE_URL=http://microservicio-2:8081/api/v1
MOVEMENTS_PATH=/movements

# ================================
# Configuración de SQL Server
# ================================
ACCEPT_EULA=Y
MSSQL_PID=Developer

# ================================
# Instrucciones de Uso
# ================================
# 1. Copiar este archivo como .env:
#    cp .env.example .env
#
# 2. Cambiar CHANGE_ME_IN_PRODUCTION por una contraseña segura
#
# 3. Agregar .env al .gitignore (ya está configurado)
#
# 4. Para producción, usar Azure Key Vault o AWS Secrets Manager
